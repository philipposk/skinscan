# Shared 6x7 Supabase project (eu-central-1 / Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Server only. Used to sign image URLs after an access check, write the audit
# log, and handle the Stripe webhook. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Vision ensemble. At least one is required; the app degrades gracefully and
# tells the user when it could only get a single opinion.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Payments
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...        # Stripe -> Developers -> Webhooks -> signing secret
CASE_PRICE_CENTS=2900

# Transactional email, used only to alert a patient when a dermatologist marks
# their case urgent.
RESEND_API_KEY=
MAIL_FROM=SkinScan <onboarding@resend.dev>
